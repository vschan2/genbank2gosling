# Copy this file to .env and adjust if your higlass-server checkout isn't
# in the default location. .env is gitignored (matched by the repo's blanket
# ".env" rule) — each machine keeps its own copy.

# Path to the higlass-server checkout, relative to this directory or absolute.
# Defaults to a sibling of genbank-pipeline/ (../../higlass-server) if unset.
HIGLASS_SERVER_DIR=../../higlass-server
